# Python System Files
__pycache__/
*.pyc

# Virtual Environments
venv/
.venv/
env/
simulation_env/

# Environment Variables
.env

# Logs and Databases
logs/
*.log
*.sqlite

# MLflow and Artifacts
mlruns/
mlartifacts/
artifacts/

# Data (Optional: usually we don't commit large raw data)
data/raw/

# Terraform — never commit real tfvars (contains secrets) or local state
infra/terraform/terraform.tfvars
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/terraform.tfstate
infra/terraform/terraform.tfstate.backup
