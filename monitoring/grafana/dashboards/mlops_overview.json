{
    "__inputs": [],
    "__requires": [
        {
            "type": "grafana",
            "id": "grafana",
            "name": "Grafana",
            "version": "10.0.0"
        },
        {
            "type": "datasource",
            "id": "prometheus",
            "name": "Prometheus",
            "version": "1.0.0"
        }
    ],
    "annotations": {
        "list": []
    },
    "description": "MLOps Churn Project — API latency, error rate, model predictions, and Postgres health",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "id": 1,
            "title": "API — Request Rate (req/s)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "rate(http_requests_total{job=\"fastapi-api\"}[1m])",
                    "legendFormat": "{{method}} {{handler}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "color": {
                        "mode": "palette-classic"
                    }
                }
            }
        },
        {
            "id": 2,
            "title": "API — P50 / P95 / P99 Latency",
            "type": "timeseries",
            "description": "15s scrape resolution exposes spikes masked by CloudWatch 1-min rollups",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"fastapi-api\",handler=\"/predict\"}[2m]))",
                    "legendFormat": "P50"
                },
                {
                    "datasource": "Prometheus",
                    "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"fastapi-api\",handler=\"/predict\"}[2m]))",
                    "legendFormat": "P95"
                },
                {
                    "datasource": "Prometheus",
                    "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"fastapi-api\",handler=\"/predict\"}[2m]))",
                    "legendFormat": "P99"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.2
                            },
                            {
                                "color": "red",
                                "value": 0.5
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 3,
            "title": "API — 5xx Error Rate",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "rate(http_requests_total{job=\"fastapi-api\",status=~\"5..\"}[2m]) / rate(http_requests_total{job=\"fastapi-api\"}[2m])",
                    "legendFormat": "5xx error rate"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 0.05
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 4,
            "title": "Model — Predictions per Minute",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "rate(http_requests_total{job=\"fastapi-api\",handler=\"/predict\",status=\"200\"}[1m]) * 60",
                    "legendFormat": "predictions/min"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                }
            }
        },
        {
            "id": 5,
            "title": "Postgres — Active Connections",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 16
            },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "pg_stat_activity_count",
                    "legendFormat": "active connections"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 50
                            },
                            {
                                "color": "red",
                                "value": 80
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 6,
            "title": "Active Alerts",
            "type": "alertlist",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 16
            },
            "options": {
                "maxItems": 10,
                "sortOrder": 1,
                "dashboardAlerts": false
            }
        }
    ],
    "refresh": "15s",
    "schemaVersion": 38,
    "tags": [
        "mlops",
        "churn",
        "fastapi",
        "prometheus"
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "timepicker": {},
    "timezone": "browser",
    "title": "MLOps Churn — Observability Dashboard",
    "uid": "mlops-churn-main",
    "version": 1
}